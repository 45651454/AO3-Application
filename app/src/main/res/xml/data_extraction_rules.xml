<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+（API 31+）数据提取规则：书库数据库与界面偏好属于隐私数据，
   且应用已在设置页提供手动导出/导入，因此云备份与设备间迁移均排除。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="library.db"/>
        <exclude domain="sharedpref" path="settings.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="library.db"/>
        <exclude domain="sharedpref" path="settings.xml"/>
    </device-transfer>
</data-extraction-rules>
